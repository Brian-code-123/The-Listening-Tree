# ──────────────────────────────────────────────────
# The Listening Tree — .gitignore
# ──────────────────────────────────────────────────

# Python virtual environments
venv/
.venv/

# Python bytecode & caches
__pycache__/
*.pyc
*.pyo

# Vosk voice models (large binary — local dev only)
voice_models/

# SQLite database (auto-created at runtime)
*.db

# Environment secrets
.env

# macOS metadata
.DS_Store
**/.DS_Store

# Editor backup files
*.bak
*.bak2

# IDE settings (uncomment if not shared)
# .vscode/
# .idea/
