# ──────────────────────────────────────────────────
# The Listening Tree — .gitignore
# ──────────────────────────────────────────────────

# Python virtual environments
venv/
.venv/
env/
ENV/

# Python bytecode & caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Vosk voice models (large binary — local dev only)
voice_models/vosk-model-*

# SQLite database (auto-created at runtime)
reminders.db
*.db
*.sqlite
*.sqlite3

# Environment secrets
.env
.env.local

# macOS metadata
.DS_Store
**/.DS_Store
Thumbs.db

# Editor backup files
*.bak
*.bak2
*~
*.swp
*.swo

# IDE settings
.vscode/
.idea/
*.code-workspace
.project
.settings/

# Node.js / npm (Capacitor project)
node_modules/
package-lock.json
npm-debug.log

# Capacitor native platform builds (regenerated via `npx cap sync`)
android/
ios/
www/capacitor-bridge.js

# Vercel deployment
.vercel/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
tests/
*.md
