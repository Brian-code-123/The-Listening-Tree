{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "vitest.config.ts",
    "tests/**/*.ts",
    "tests/**/*.js",
    "scripts/**/*.ts"
  ]
}