# The Listening Tree — Environment Configuration Template
# 
# Copy this file to .env and fill in your credentials.
# This template shows all available configuration options.

# ─────────────────────────────────────────────────────────────
# REQUIRED: Tencent Hunyuan LLM Configuration
# ─────────────────────────────────────────────────────────────

# Your Tencent Hunyuan API key (required for chat functionality)
# Obtain from: https://www.tencentcloud.com/products/hunyuan
HUNYUAN_API_KEY=your_hunyuan_api_key_here

# (Optional) Tencent Hunyuan API endpoint
# Default: https://api.hunyuan.cloud.tencent.com/v1
# HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1

# (Optional) Tencent Hunyuan model name
# Default: hunyuan-pro
# HUNYUAN_MODEL=hunyuan-pro

# ─────────────────────────────────────────────────────────────
# OPTIONAL: Session & Security
# ─────────────────────────────────────────────────────────────

# Secret key for session signing (production: use strong random value)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# If not set, generates ephemeral key at startup (lost on restart)
SECRET_KEY=your_secret_key_here

# ─────────────────────────────────────────────────────────────
# OPTIONAL: News API
# ─────────────────────────────────────────────────────────────

# NewsAPI key for live HK news (optional)
# If not set, uses fallback hardcoded articles
# Obtain from: https://newsapi.org
# NEWS_API_KEY=your_newsapi_key_here

# ─────────────────────────────────────────────────────────────
# OPTIONAL: Database Configuration (Production)
# ─────────────────────────────────────────────────────────────

# Database URL for external PostgreSQL (Vercel deployments)
# Local default: reminders.db (SQLite)
# Vercel fallback: /tmp/reminders.db (ephemeral, data not persisted)
#
# Production databases (recommended for Vercel):
#   Supabase    : postgresql://user:password@db.supabase.co:5432/postgres
#   Neon        : postgresql://user:password@ep-xyz.us-east-1.neon.tech/neondb
#   Planetscale : mysql://user:password@pscale_aws_region.psdb.cloud:3306/database
#
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─────────────────────────────────────────────────────────────
# OPTIONAL: Server Configuration
# ─────────────────────────────────────────────────────────────

# Server port (default: 5000)
PORT=5000
