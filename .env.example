# AI provider
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# Optional news feed
NEWS_API_KEY=your-newsapi-key

# Email (Azure Communication Services) — registration verification codes
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
AZURE_SENDER_EMAIL=DoNotReply@<guid>.azurecomm.net

# Speech-to-text — Hugging Face Inference API (Whisper large-v3)
# Get a token at https://huggingface.co/settings/tokens
HF_API_KEY=your-huggingface-api-token
HF_WHISPER_MODEL=openai/whisper-large-v3

# Database
# Supabase Postgres example (Transaction/Pooling URL):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase public client config (for JS/TS utilities)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxx

# IMPORTANT for stable login session across deploys:
# Must be a fixed, long random string in production.
SECRET_KEY=replace-with-a-long-random-secret

# Google Sign-In (OAuth 2.0 client from Google Cloud Console / Auth Platform)
# Leave unset to disable the "Sign in with Google" button entirely.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must exactly match an Authorized redirect URI configured on the OAuth client.
GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback

# Server
PORT=5000
