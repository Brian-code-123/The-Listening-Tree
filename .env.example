# AI provider
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# Optional news feed
NEWS_API_KEY=your-newsapi-key

# Database
# Local SQLite example:
# DATABASE_URL=reminders.db
# Supabase Postgres example (Transaction/Pooling URL):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=reminders.db

# IMPORTANT for stable login session across deploys:
# Must be a fixed, long random string in production.
SECRET_KEY=replace-with-a-long-random-secret

# Server
PORT=5000
