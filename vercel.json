{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": { "root": ".", "entrypoint": "api/index.py" },
    "history": { "root": "web-next" }
  },
  "rewrites": [
    { "source": "/_next/(.*)", "destination": { "service": "history" } },
    { "source": "/history", "destination": { "service": "history" } },
    { "source": "/history/(.*)", "destination": { "service": "history" } },
    { "source": "/register", "destination": { "service": "history" } },
    { "source": "/login", "destination": { "service": "history" } },
    { "source": "/profile", "destination": { "service": "history" } },
    { "source": "/accessibility", "destination": { "service": "history" } },
    { "source": "/hk_guide", "destination": { "service": "history" } },
    { "source": "/(.*)", "destination": { "service": "api" } }
  ]
}
